  "metric_definitions": {
    "dice": "2|P\u2229R|/(|P|+|R|); 1.0 when both empty",
    "sensitivity": "|P\u2229R|/|R|; undefined (excluded from mean) when the reference region is empty",
    "hd95_mm": "max of the two directed 95th-percentile surface distances, in mm; undefined if exactly one is empty"
  },
  "model": {
    "name": "MONAI brats_mri_segmentation (SegResNet)",
    "version": "0.5.4",
    "licence": "Apache-2.0 (MONAI Consortium)",
    "training_data": "BraTS 2018 (285 cases; bundle authors' own split)",
    "source": "https://huggingface.co/MONAI/brats_mri_segmentation"
  },
  "preprocessing": "Stack sequences as [T1Gd, T1, T2, FLAIR]; reorient to RAS; resample to 1 mm isotropic (bilinear); z-score intensity normalisation per channel over non-zero voxels; sliding-window inference with AMP; sigmoid; invert resampling/orientation back to the input grid (bilinear on probabilities); threshold 0.5; TC/WT/ET channels -> BraTS codes (ET=4, TC without ET=1, WT without TC=2). Uncertainty: 3 extra passes on the input mirrored along each axis (label map from the plain pass).",
  "code_commit": "db28f88841d639b391be0fc5f42e00a5444b1bfb",
  "overlap_disclosure": "We did not train or fine-tune the model, so none of these cases were used by us for training or tuning. However, the pretrained MONAI model was trained on BraTS 2018, and Decathlon Task01 is built from BraTS 2016 and 2017 cases, which BraTS 2018 largely re-uses. Decathlon renamed the cases, so we cannot tell which evaluation cases the model saw during its training; most probably overlap. These metrics are therefore likely optimistic and are not an independent held-out estimate.",
  "split_note": "Patient-wise split: Decathlon Task01 provides one multi-sequence study per subject (BRATS_xxx), so each case ID is one patient. Evaluation cases were sampled at random (fixed seed) from the labelled training list. Our training/fine-tuning set is empty (pretrained model used as-is). Judge-provided cases are never used for training or tuning and uploads are deleted within 24 h."
